# =============================================================================
# Attendance Platform — monorepo (.gitignore)
# frontend/ (Vite/React) · backend/ (FastAPI backend + AI)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & secrets (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# -----------------------------------------------------------------------------
# Node / Vite / React (frontend/)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.local
frontend/.vite/
frontend/coverage/
frontend/.eslintcache

# Lock files: keep package-lock.json & composer.lock in git (reproducible installs)

# -----------------------------------------------------------------------------
# Python / FastAPI (backend/)
# -----------------------------------------------------------------------------
backend/venv/
backend/.venv/
backend/env/
backend/__pycache__/
backend/**/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/*.egg-info/
backend/.eggs/
backend/build/
backend/dist/
backend/wheels/
backend/*.egg

# FAISS index & enrollment metadata (generated at runtime)
backend/data/*
!backend/data/.gitkeep

# Anti-spoof ONNX weights (download via scripts/download_antispoof_model.py)
backend/models/*
!backend/models/.gitkeep

# -----------------------------------------------------------------------------
# Logs & debug
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# IDE & editors
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.temp
.cache/

# -----------------------------------------------------------------------------
# Windows installer prereqs (large binaries — download before building; see prereqs/README.md)
# -----------------------------------------------------------------------------
windows/installer/prereqs/postgresql/*
!windows/installer/prereqs/postgresql/.gitkeep
windows/installer/prereqs/python/*
!windows/installer/prereqs/python/.gitkeep
windows/installer/prereqs/nginx/*
!windows/installer/prereqs/nginx/.gitkeep
windows/installer/prereqs/redis/*
!windows/installer/prereqs/redis/.gitkeep
windows/installer/prereqs/models/*
!windows/installer/prereqs/models/.gitkeep
windows/installer/prereqs/wheelhouse/*
!windows/installer/prereqs/wheelhouse/.gitkeep

# Launcher build artifacts (build with dotnet before compiling Inno Setup)
windows/launcher/**/bin/
windows/launcher/**/obj/
windows/launcher/publish/

# -----------------------------------------------------------------------------
# Windows installer outputs (generated)
# -----------------------------------------------------------------------------
# Inno Setup common output folders
windows/installer/inno/Output/
windows/installer/inno/Output/*
windows/installer/inno/*.exe

# Our default installer output name
AttendancePlatformSetup*.exe

# Windows icon generation artifacts
windows/assets/app.ico
