# ─── Application ──────────────────────────────────────────────
APP_NAME=Attendance Platform
APP_ENV=production
APP_DEBUG=false

# Comma-separated browser origins allowed by CORS. Do NOT use "*" in
# production (it is rejected when APP_ENV=production).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── JWT Auth ─────────────────────────────────────────────────
# REQUIRED in production: generate a strong unique value, e.g.
#   python -c "import secrets; print(secrets.token_hex(64))"
# Boot will fail if APP_ENV=production and this is left at the default.
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── AI / Recognition ────────────────────────────────────────
RECOGNITION_THRESHOLD=0.95
LIVENESS_ENABLED=true
LIVENESS_MIN_DET_SCORE=0.45
NFR_RECOGNITION_SLA_MS=500
NFR_MAX_EMPLOYEES=10000
NFR_MAX_CAMERAS=100

# FR-017 Anti-spoof (MiniFASNetV2 ONNX — print/screen/deepfake)
ANTISPOOF_ENABLED=true
ANTISPOOF_BLOCK_ENROLLMENT=true
ANTISPOOF_MODEL_PATH=models/MiniFASNetV2.onnx
ANTISPOOF_REAL_THRESHOLD=0.5
ANTISPOOF_HEURISTIC_THRESHOLD=0.35
ANTISPOOF_REQUIRE_BOTH=true

# FR-018 Active liveness (blink + head movement on frame sequence)
ACTIVE_LIVENESS_ENABLED=true
ACTIVE_LIVENESS_MIN_FRAMES=5
ACTIVE_LIVENESS_MAX_FRAMES=24
ACTIVE_LIVENESS_REQUIRE_BLINK=true
ACTIVE_LIVENESS_REQUIRE_HEAD_MOVEMENT=false
ACTIVE_LIVENESS_REQUIRE_FRAMES=false
ACTIVE_LIVENESS_BLINK_VARIANCE_DROP=0.35
ACTIVE_LIVENESS_HEAD_YAW_RANGE=0.06
ACTIVE_LIVENESS_HEAD_PITCH_RANGE=0.05

# FR-006 enrollment limits
ENROLLMENT_MIN_IMAGES=10
ENROLLMENT_MAX_IMAGES=50
ENROLLMENT_STRUCTURED_POSES=front,left,right,up,down,smiling,neutral,glasses,without_glasses
QUALITY_MIN_BLUR_SCORE=0.35
QUALITY_MIN_BRIGHTNESS_SCORE=0.35
QUALITY_MIN_OCCLUSION_SCORE=0.4
QUALITY_MIN_RESOLUTION_SCORE=0.5
QUALITY_MIN_FACE_PIXELS=80

RECOGNITION_SLA_MS=300
LIVENESS_SLA_MS=500
TARGET_ACCURACY=0.99
MAX_FALSE_POSITIVE_RATE=0.001
MAX_FALSE_NEGATIVE_RATE=0.01

INDEX_PATH=data/faiss.index
METADATA_PATH=data/metadata.json
