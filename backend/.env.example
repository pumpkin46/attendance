APP_NAME="Attendance Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use redis in production when Redis is available
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

AI_SERVICE_URL=http://127.0.0.1:8001
# NFR-005: comma-separated recognition nodes for horizontal scaling
# AI_SERVICE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002
AI_RECOGNITION_THRESHOLD=0.95
AI_REQUEST_TIMEOUT=2

# --- Non-functional requirements (NFR) ---
NFR_RECOGNITION_SLA_MS=500
NFR_MAX_EMPLOYEES=10000
NFR_MAX_CAMERAS=100
NFR_UPTIME_TARGET=99.9
NFR_HORIZONTAL_SCALING=true
NFR_TLS_MIN_VERSION=1.3
NFR_ENCRYPTION_CIPHER=AES-256-CBC

# NFR-007 Password hashing (requires ext-sodium for argon2id)
HASH_DRIVER=argon2id
# Legacy bcrypt hashes from older seeds are verified and upgraded on login automatically.
ARGON_MEMORY=65536
ARGON_TIME=4

# NFR-006 Production HTTPS (set APP_ENV=production + FORCE_HTTPS=true)
FORCE_HTTPS=false

# NFR-008 GDPR / privacy retention (days)
GDPR_ENABLED=true
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_RECOGNITION_EVENTS_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=90
PRIVACY_CONTACT_EMAIL=privacy@attendance.local

FACE_DUPLICATE_WINDOW_SECONDS=60
RFID_DUPLICATE_WINDOW_SECONDS=60
RFID_READER_OFFLINE_SECONDS=300
EDGE_DEVICE_OFFLINE_SECONDS=300
EDGE_SYNC_INTERVAL_SECONDS=300
ANOMALY_DETECTION_ENABLED=true
ANOMALY_LOOKBACK_DAYS=30
ANOMALY_OVERTIME_MINUTES=600
ANOMALY_CHECKIN_DEVIATION_MINUTES=120
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=480

# FR-006 / FR-008 Face enrollment (10–50 images, optional raw retention)
# Visitors (§11)
VISITOR_DEFAULT_VISIT_HOURS=8
VISITOR_FACE_EXPIRY_BUFFER_MINUTES=30
VISITOR_KIOSK_OFFLINE_SECONDS=300
VISITOR_KIOSK_DEFAULT_VISIT_HOURS=4
VISITOR_BADGE_PREFIX=V

# Smart Building Integration
BUILDING_INTEGRATION_ENABLED=true
BUILDING_WEBHOOK_TIMEOUT=5
BUILDING_BUSINESS_HOURS_START=08:00
BUILDING_BUSINESS_HOURS_END=18:00
BUILDING_BUSINESS_TIMEZONE=UTC

# AI Security Monitoring
SECURITY_MONITORING_ENABLED=true
SECURITY_AFTER_HOURS_START=20:00
SECURITY_AFTER_HOURS_END=06:00
SECURITY_TAILGATING_WINDOW=8
SECURITY_ALERT_COOLDOWN=120

# Attendance policies (§5)
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_MIN_WORK_MINUTES=240
ATTENDANCE_MAX_WORK_MINUTES=600
ATTENDANCE_BREAK_MINUTES=60
ATTENDANCE_HALF_DAY_MINUTES=240
ATTENDANCE_MIN_CONFIDENCE=0.95
ATTENDANCE_NIGHT_START=22:00
ATTENDANCE_NIGHT_END=06:00

# Recognition engine (§4)
RECOGNITION_SLA_MS=300
LIVENESS_SLA_MS=500
RECOGNITION_TARGET_ACCURACY=0.99
RECOGNITION_MAX_FPR=0.001
RECOGNITION_MAX_FNR=0.01
NFR_RECOGNITION_SLA_MS=300
NFR_LIVENESS_SLA_MS=500

FACE_ENROLLMENT_MODE=structured
FACE_ENROLLMENT_REQUIRED_POSES=front,left,right,up,down,smiling,neutral,glasses,without_glasses
FACE_ENROLLMENT_MIN_IMAGES=10
FACE_ENROLLMENT_MAX_IMAGES=50
FACE_ENROLLMENT_RETAIN_RAW_IMAGES=false

# FR-011 Unknown face handling
UNKNOWN_PERSON_ALERT=true
UNKNOWN_SNAPSHOT_ENABLED=true
UNKNOWN_NOTIFY_ADMINS=true
UNKNOWN_ALERT_COOLDOWN_SECONDS=300
UNKNOWN_SNAPSHOT_RETENTION_DAYS=30
CAMERA_STREAM_POLL_INTERVAL_SECONDS=5
CAMERA_ONLINE_THRESHOLD_SECONDS=120
CAMERA_HEALTH_LOG_RETENTION_DAYS=7
CAMERA_HEALTH_LOG_INTERVAL_SECONDS=300

# --- Security (§16) ---
TENANT_ISOLATION_ENABLED=true
FORCE_HTTPS=false
NFR_TLS_MIN_VERSION=1.3
NFR_ENCRYPTION_CIPHER=AES-256-CBC
SECRETS_DRIVER=env
VAULT_ADDR=
AWS_KMS_KEY_ID=

OAUTH_ENABLED=true
OAUTH_PROVIDERS=google,microsoft

SAML_ENABLED=false
SAML_ENTITY_ID=
SAML_SSO_URL=
SAML_ACS_URL=
SAML_CERTIFICATE=

LDAP_ENABLED=false
LDAP_AD_MODE=false
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_TLS=true
