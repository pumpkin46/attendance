APP_NAME="Attendance Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use redis in production when Redis is available
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

AI_SERVICE_URL=http://127.0.0.1:8001
AI_RECOGNITION_THRESHOLD=0.95
AI_REQUEST_TIMEOUT=5

FACE_DUPLICATE_WINDOW_SECONDS=60
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=480

# FR-006 / FR-008 Face enrollment (10–50 images, optional raw retention)
FACE_ENROLLMENT_MIN_IMAGES=10
FACE_ENROLLMENT_MAX_IMAGES=50
FACE_ENROLLMENT_RETAIN_RAW_IMAGES=false

# FR-006 / FR-008 Face enrollment
FACE_ENROLLMENT_MIN_IMAGES=10
FACE_ENROLLMENT_MAX_IMAGES=50
FACE_ENROLLMENT_RETAIN_RAW_IMAGES=false
