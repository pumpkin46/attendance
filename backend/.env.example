# ─── Application ──────────────────────────────────────────────
APP_NAME=Attendance Platform
APP_ENV=production
APP_DEBUG=false

# Comma-separated browser origins allowed by CORS. Do NOT use "*" in
# production (it is rejected when APP_ENV=production).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=postgres
DB_PASSWORD=123456789

# ─── Redis ────────────────────────────────────────────────────
# When REDIS_ENABLED=true, duplicate-suppression and rate-limiting use Redis so
# limits hold across all workers/nodes. When false (default), they fall back to
# per-process in-memory behaviour.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Celery (background tasks) ────────────────────────────────
# When CELERY_ENABLED=true, periodic jobs (visitor expiry, anomaly detection,
# GDPR retention purge) run via Celery Beat instead of the in-process loop. Run:
#   celery -A app.celery_app.celery_app worker --loglevel=info
#   celery -A app.celery_app.celery_app beat   --loglevel=info
# Broker/backend default to REDIS_URL when unset.
CELERY_ENABLED=true
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
BEAT_VISITOR_EXPIRY_SECONDS=60
BEAT_ANOMALY_DETECTION_SECONDS=3600
BEAT_RETENTION_PURGE_SECONDS=86400

# ─── JWT Auth ─────────────────────────────────────────────────
# REQUIRED in production: generate a strong unique value, e.g.
#   python -c "import secrets; print(secrets.token_hex(64))"
# Boot will fail if APP_ENV=production and this is left at the default.
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── AI / Recognition ────────────────────────────────────────
# Cosine-similarity match floor for ArcFace (InsightFace buffalo_l) embeddings.
# Same-person similarity across different captures is typically ~0.4–0.7, so a
# value near 1.0 rejects genuine matches as "unknown". 0.5 balances match rate
# vs. false accepts; lower toward 0.4 if real faces are missed, raise toward 0.6
# to be stricter.
RECOGNITION_THRESHOLD=0.4
# Detection input resolution (square, px) for the recognition pipeline. CPU cost
# scales ~quadratically with this. Measured on this CPU-only host (VUS=1, warm):
#   640 → ~392ms median   480 → ~320ms median   320 → ~284ms median
# 480 is the balanced default: ~25% faster than 640 with little recall risk.
# Drop to 320 only after validating recall at your real camera distances; the
# <300ms NFR ultimately needs a GPU. Default in code is 640.
RECOGNITION_DET_SIZE=480
LIVENESS_ENABLED=true
LIVENESS_MIN_DET_SCORE=0.45

# Throttle persisted "unknown" recognition events per tenant (seconds). A
# continuously-scanning kiosk produces an unknown almost every frame; 30s keeps
# the DB rows + snapshots manageable. 0 disables (record every unknown).
#UNKNOWN_EVENT_THROTTLE_SECONDS=30
UNKNOWN_SNAPSHOT_RETENTION_DAYS=30
UNKNOWN_SNAPSHOT_ENABLED=true

# FR-017 Anti-spoof (MiniFASNetV2 ONNX — print/screen/deepfake)
ANTISPOOF_ENABLED=true
ANTISPOOF_BLOCK_ENROLLMENT=true
ANTISPOOF_MODEL_PATH=models/MiniFASNetV2.onnx
ANTISPOOF_REAL_THRESHOLD=0.5
ANTISPOOF_HEURISTIC_THRESHOLD=0.35
ANTISPOOF_REQUIRE_BOTH=true

# FR-018 Active liveness (blink + head movement on frame sequence)
# Disabled: per-frame face detection on the buffered sequence was the dominant
# cost of a kiosk identify (~12s). Passive single-frame anti-spoof below still
# guards against print/screen replay. Re-enable for blink-based anti-replay.
ACTIVE_LIVENESS_ENABLED=false
ACTIVE_LIVENESS_MIN_FRAMES=5
ACTIVE_LIVENESS_MAX_FRAMES=12
ACTIVE_LIVENESS_REQUIRE_BLINK=true
ACTIVE_LIVENESS_REQUIRE_HEAD_MOVEMENT=false
ACTIVE_LIVENESS_REQUIRE_FRAMES=false
ACTIVE_LIVENESS_BLINK_VARIANCE_DROP=0.35
ACTIVE_LIVENESS_HEAD_YAW_RANGE=0.06
ACTIVE_LIVENESS_HEAD_PITCH_RANGE=0.05

# FR-006 enrollment limits
ENROLLMENT_MIN_IMAGES=10
ENROLLMENT_MAX_IMAGES=50
ENROLLMENT_STRUCTURED_POSES=front,left,right,up,down,smiling,neutral,glasses,without_glasses
QUALITY_MIN_BLUR_SCORE=0.25
QUALITY_MIN_BRIGHTNESS_SCORE=0.35
QUALITY_MIN_OCCLUSION_SCORE=0.4
QUALITY_MIN_RESOLUTION_SCORE=0.5
QUALITY_MIN_FACE_PIXELS=80

RECOGNITION_SLA_MS=300
LIVENESS_SLA_MS=500
TARGET_ACCURACY=0.99
MAX_FALSE_POSITIVE_RATE=0.001
MAX_FALSE_NEGATIVE_RATE=0.01

INDEX_PATH=data/faiss.index
METADATA_PATH=data/metadata.json

# --- Additional settings (auto-generated from config.py defaults) -----
# Every remaining Settings field, with its current effective value.
# Uncomment/edit to override; deleting a line falls back to the code default.

APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=UTC
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_RECOGNITION_MAX=60
RATE_LIMIT_RECOGNITION_WINDOW_SECONDS=60
TENANT_ISOLATION_ENABLED=true
TENANT_HEADER=X-Organization-Id
SUPER_ADMIN_ROLE=super_admin
GDPR_ENABLED=true
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_RECOGNITION_EVENTS_DAYS=90
PRIVACY_CONTACT_EMAIL=privacy@attendance.local
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_MIN_WORK_MINUTES=240
ATTENDANCE_MAX_WORK_MINUTES=600
ATTENDANCE_BREAK_MINUTES=60
ATTENDANCE_HALF_DAY_MINUTES=240
ATTENDANCE_MIN_CONFIDENCE=0.5
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=480
FACE_DUPLICATE_WINDOW_SECONDS=60
RFID_DUPLICATE_WINDOW_SECONDS=60
ANOMALY_DETECTION_ENABLED=true
ANOMALY_LOOKBACK_DAYS=30
ANOMALY_OVERTIME_MINUTES=600
ANOMALY_CHECKIN_DEVIATION_MINUTES=120
FACE_ENROLLMENT_MODE=structured
FACE_ENROLLMENT_REQUIRED_POSES=front,left,right,up,down,smiling,neutral,glasses,without_glasses
FACE_ENROLLMENT_MIN_IMAGES=10
FACE_ENROLLMENT_MAX_IMAGES=50
FACE_ENROLLMENT_RETAIN_RAW_IMAGES=false
# Guided enrollments (with pose slots) must cover every required pose
FACE_ENROLLMENT_ENFORCE_POSE_COVERAGE=true
UNKNOWN_PERSON_ALERT=true
UNKNOWN_NOTIFY_ADMINS=true
UNKNOWN_ALERT_COOLDOWN_SECONDS=300
UNKNOWN_EVENT_THROTTLE_SECONDS=0
CAMERA_STREAM_POLL_INTERVAL_SECONDS=5
CAMERA_ONLINE_THRESHOLD_SECONDS=120
CAMERA_HEALTH_LOG_RETENTION_DAYS=7
CAMERA_HEALTH_LOG_INTERVAL_SECONDS=300
RFID_READER_OFFLINE_SECONDS=300
EDGE_DEVICE_OFFLINE_SECONDS=300
EDGE_SYNC_INTERVAL_SECONDS=300
VISITOR_DEFAULT_VISIT_HOURS=8
VISITOR_FACE_EXPIRY_BUFFER_MINUTES=30
VISITOR_BADGE_PREFIX=V
VISITOR_UPLOAD_DIR=data/uploads
BUILDING_INTEGRATION_ENABLED=true
BUILDING_WEBHOOK_TIMEOUT=5
BUILDING_BUSINESS_HOURS_START=08:00
BUILDING_BUSINESS_HOURS_END=18:00
BUILDING_BUSINESS_TIMEZONE=UTC
SECURITY_MONITORING_ENABLED=true
SECURITY_AFTER_HOURS_START=20:00
SECURITY_AFTER_HOURS_END=06:00
SECURITY_TAILGATING_WINDOW=8
SECURITY_ALERT_COOLDOWN=120
OAUTH_ENABLED=false
SAML_ENABLED=false
LDAP_ENABLED=false
RECOGNITION_REQUIRE_QUALITY=false
EMBEDDING_DIM=512
USE_MOCK_WHEN_NO_GPU=true
MAX_PROCESSING_MS=500
MAX_EMPLOYEES=10000
MAX_CAMERAS=100
ANTISPOOF_MODEL_URL=https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV2.onnx
ANTISPOOF_CROP_SCALE=2.7
ANTISPOOF_COMBINED_THRESHOLD=0.45
ANTISPOOF_FAIL_WITHOUT_MODEL=false
QUALITY_MIN_DET_SCORE=0.5
QUALITY_MIN_OVERALL_SCORE=0.45
QUALITY_BLUR_VARIANCE_REF=120.0
ENGINE_ENABLED=true
ENGINE_AUTO_START=false
ENGINE_MAX_CONCURRENT_RECOGNITIONS=50
ENGINE_SNAPSHOT_DIR=data/snapshots/unknown
ENGINE_LIVENESS_THRESHOLD=0.85
ENGINE_DUPLICATE_WINDOW_SECONDS=300
ENGINE_UNKNOWN_ALERT_COOLDOWN=300
ENGINE_MAX_TRACKS_PER_CAMERA=200
ENGINE_TRACK_COOLDOWN_SECONDS=5.0
ENGINE_AUTO_ACCEPT_THRESHOLD=0.9
ENGINE_REVIEW_THRESHOLD=0.8
