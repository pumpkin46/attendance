<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AttendanceLauncher</AssemblyName>
    <RootNamespace>AttendanceLauncher</RootNamespace>
    <Version>2.0.0</Version>
    <!-- Self-contained single-file publish so the target needs no .NET runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- The icon is generated by build-installer.ps1 (assets\app.ico) before this
       project is published; embed it only when present so design-time builds work. -->
  <PropertyGroup Condition="Exists('..\..\assets\app.ico')">
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\assets\app.ico')">
    <None Include="..\..\assets\app.ico">
      <Link>app.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
